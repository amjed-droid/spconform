# تأكد من تحميل الحزمة الأصلية
library(spconform)
cat("=======================================================\n")
cat(" تجربة spconform (Pure R) على بيانات مناخية لمحطات رصد\n")
cat("=======================================================\n\n")
# 1. توليد بيانات مناخية مكانية (محاكاة جغرافية للعراق)
set.seed(2026)
n_stations <- 500 # لدينا 500 محطة رصد مناخي
# حدود العراق الجغرافية التقريبية
# خطوط الطول (Lon): 39.0 إلى 48.0
# دوائر العرض (Lat): 29.0 (الجنوب) إلى 37.0 (الشمال)
lon <- runif(n_stations, 39.0, 48.0)
lat <- runif(n_stations, 29.0, 37.0)
s_climate <- cbind(lon, lat)
# محاكاة درجة الحرارة (أكثر حرارة في الجنوب، وأبرد في الشمال)
# معادلة تقريبية: حرارة أساسية - (تأثير دائرة العرض) + ضوضاء مكانية (تأثير التضاريس)
noise <- rnorm(n_stations, mean = 0, sd = 1.5)
temp <- 65 - (0.8 * lat) + (0.1 * lon) + noise
# تقسيم البيانات: 400 محطة للتدريب، و 100 موقع جديد نريد التنبؤ بحرارته
idx_train <- sample(n_stations, 400)
s_train <- s_climate[idx_train, ]
y_train <- temp[idx_train]
s_test <- s_climate[-idx_train, ]
y_test <- temp[-idx_train]
# 2. تعريف دالة التنبؤ (نموذج انحدار خطي يعتمد على الموقع الجغرافي)
pred_fun_climate <- function(s_train, y_train, s_new) {
fit <- lm(y_train ~ s_train[, 1] + s_train[, 2])
cbind(1, s_new[, 1], s_new[, 2]) %*% coef(fit)
}
# 3. تشغيل الخوارزمية (النسخة الأصلية Pure R)
cat("جاري حساب فترات التنبؤ المطابق المكاني...\n")
climate_intervals <- scp_geostatistical(
s_train = s_train,
y_train = y_train,
s0 = s_test,
pred_fun = pred_fun_climate,
alpha = 0.1 # مستوى ثقة 90%
)
# 4. تقييم النتائج وعرضها
cat("\n=== ملخص التغطية (Coverage Report) ===\n")
report <- coverage_report(climate_intervals, y_true = y_test)
print(report)
cat("\n=== عينة لـ 5 مواقع اختبار (التنبؤ بدرجة الحرارة) ===\n")
results_df <- data.frame(
Longitude = round(s_test[1:5, 1], 2),
Latitude = round(s_test[1:5, 2], 2),
True_Temp = round(y_test[1:5], 1),
Predicted = round(climate_intervals$pred[1:5], 1),
Lower_Bound = round(climate_intervals$lower[1:5], 1),
Upper_Bound = round(climate_intervals$upper[1:5], 1)
)
print(results_df)
# تأكد من تثبيت الحزمة إذا لم تكن موجودة: install.packages("ggplot2")
library(ggplot2)
# 1. تجميع البيانات في جدول واحد
plot_data <- data.frame(
True_Temp = y_test,
Predicted = climate_intervals$pred,
Lower = climate_intervals$lower,
Upper = climate_intervals$upper
)
# 2. تحديد حالة التغطية (هل القيمة الحقيقية داخل الفترة؟)
plot_data$Covered <- plot_data$True_Temp >= plot_data$Lower & plot_data$True_Temp <= plot_data$Upper
# 3. ترتيب البيانات تصاعدياً حسب التنبؤ ليكون الرسم مرتباً وسهل القراءة
plot_data <- plot_data[order(plot_data$Predicted), ]
plot_data$ID <- 1:nrow(plot_data) # إعطاء رقم متسلسل لكل موقع على المحور السيني
# 4. بناء الرسم البياني الاحترافي
p <- ggplot(plot_data, aes(x = ID)) +
# رسم فترات التنبؤ كخطوط عمودية رمادية
geom_linerange(aes(ymin = Lower, ymax = Upper), color = "gray75", alpha = 0.8, linewidth = 1.2) +
# رسم خط يمثل القيمة المتوقعة (المركز)
geom_line(aes(y = Predicted), color = "black", linetype = "dashed", linewidth = 0.6) +
# رسم القيم الحقيقية كنقاط ملونة حسب التغطية
geom_point(aes(y = True_Temp, color = Covered), size = 2.5, alpha = 0.9) +
# تخصيص الألوان
scale_color_manual(
values = c("TRUE" = "#0072B2", "FALSE" = "#D55E00"),
labels = c("TRUE" = "مغطاة (داخل الفترة)", "FALSE" = "غير مغطاة (خطأ)")
) +
# التسميات واللمسات الجمالية
labs(
title = "Conformal Prediction Intervals for Spatial Climate Data",
subtitle = "Target Coverage: 90% | Gray lines represent prediction intervals",
x = "Test Locations (Sorted by Predicted Temperature)",
y = "Temperature (°C)",
color = "Status:"
) +
theme_minimal(base_size = 14) +
theme(
legend.position = "bottom",
plot.title = element_text(face = "bold", size = 16),
panel.grid.minor = element_blank()
)
# 5. عرض اللوحة الفنية!
print(p)
# 1. التأكد من توفر الحزم اللازمة للبيانات الحقيقية
if (!requireNamespace("sp", quietly = TRUE)) install.packages("sp")
library(sp)
library(spconform)
# 2. تحميل البيانات الحقيقية الشهيرة (Meuse dataset)
data(meuse, package = "sp")
# لنلقي نظرة على البيانات الحقيقية:
# الإحداثيات المكانية موجودة في عمود x و y
# متغير الهدف الحقيقي هو تركيز الزنك (zinc) في التربة
head(meuse)
# 3. تجهيز الإحداثيات (سداسية الأبعاد أو ثنائية الأبعاد x, y) ومتغير الهدف
# سنأخذ إحداثيات محطات الرصد الحقيقية
s_coords <- as.matrix(meuse[, c("x", "y")])
# متغير الهدف الحقيقي: تركيز عنصر الزنك (Zinc) في التربة
y_zinc <- meuse$zinc
# 4. تقسيم البيانات الحقيقية: 100 محطة للتدريب، والباقي لاختبار تنبؤات الحزمة
set.seed(2026)
n_total <- nrow(meuse)
idx_train <- sample(n_total, 100)
s_train <- s_coords[idx_train, ]
y_train <- y_zinc[idx_train]
s_test <- s_coords[-idx_train, ]
y_test <- y_zinc[-idx_train]
# 5. بناء نموذج الانحدار للتنبؤ بتركز الزنك بناءً على الموقع المكاني (x, y)
pred_fun_meuse <- function(s_train, y_train, s_new) {
# نموذج انحدار خطي يعتمد على الموقع المكاني الحقيقي للمحطة
fit <- lm(y_train ~ s_train[, 1] + s_train[, 2])
# التنبؤ للمواقع الجديدة
cbind(1, s_new[, 1], s_new[, 2]) %*% coef(fit)
}
# 6. تشغيل حزمتك (spconform) على البيانات الحقيقية!
cat("جاري حساب فترات التنبؤ المطابق على بيانات تربة نهر Meuse الحقيقية...\n")
meuse_intervals <- scp_geostatistical(
s_train = s_train,
y_train = y_train,
s0 = s_test,
pred_fun = pred_fun_meuse,
alpha = 0.1 # مستوى ثقة 90%
)
# 7. تقييم النتائج الحقيقية
cat("\n=== تقرير تغطية البيانات الحقيقية (Coverage Report) ===\n")
report <- coverage_report(meuse_intervals, y_true = y_test)
print(report)
# 8. عرض عينة حقيقية للمقارنة بين القيمة الحقيقية وتنبؤات حزمتك
cat("\n=== عينة من تنبؤات الزنك في تربة نهر Meuse الحقيقية ===\n")
results_real <- data.frame(
X_Coord = round(s_test[1:5, 1], 0),
Y_Coord = round(s_test[1:5, 2], 0),
True_Zinc = y_test[1:5],
Predicted = round(meuse_intervals$pred[1:5], 1),
Lower_Bound = round(meuse_intervals$lower[1:5], 1),
Upper_Bound = round(meuse_intervals$upper[1:5], 1)
)
print(results_real)
citation("spconform")
install.packages("knitr")

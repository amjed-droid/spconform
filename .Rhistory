devtools::load_all() # أو library(spconform)
# 1. إعداد بيئة المحاكاة المكانية
set.seed(2026)
n_train <- 300
n_test  <- 80
# توليد إحداثيات ثنائية الأبعاد في الفضاء المكاني [-2, 2]
s_all <- matrix(runif(2 * (n_train + n_test), min = -2, max = 2), ncol = 2)
# الحقل المكاني الحقيقي (True non-linear spatial signal)
true_surface <- function(s) {
sin(s[, 1] * 2) + cos(s[, 2] * 2) + 0.5 * (s[, 1] * s[, 2])
}
# تباين مكاني غير متجانس: يزداد التشتت والخطأ كلما ابتعدنا عن المركز
sigma_spatial <- function(s) {
0.15 + 0.40 * sqrt(s[, 1]^2 + s[, 2]^2) / sqrt(8)
}
# توليد الاستجابة المكانية مع الضوضاء غير المتجانسة
y_all <- true_surface(s_all) + rnorm(n_train + n_test, mean = 0, sd = sigma_spatial(s_all))
# تقسيم البيانات إلى تدريب واختبار
s_train <- s_all[1:n_train, ]
y_train <- y_all[1:n_train]
s_test  <- s_all[(n_train + 1):(n_train + n_test), ]
y_test  <- y_all[(n_train + 1):(n_train + n_test)]
# دالة التنبؤ النقطي الأساسية (Point Predictor)
pred_fun <- function(s_tr, y_tr, s_new) {
fit <- lm(y_tr ~ poly(s_tr[, 1], 2) + poly(s_tr[, 2], 2) + s_tr[, 1]:s_tr[, 2])
as.numeric(cbind(1, poly(s_new[, 1], 2), poly(s_new[, 2], 2), s_new[, 1] * s_new[, 2]) %*% coef(fit))
}
# 2. تطبيق التنبؤ التوافقي المكاني بمستوى ثقة 90% (alpha = 0.10)
out <- scp_geostatistical(
s_train  = s_train,
y_train  = y_train,
s_test   = s_test,
pred_fun = pred_fun,
alpha    = 0.10,
seed     = 42
)
# 1. إعداد بيئة المحاكاة المكانية
set.seed(2026)
n_train <- 300
n_test  <- 80
s_all <- matrix(runif(2 * (n_train + n_test), min = -2, max = 2), ncol = 2)
true_surface <- function(s) {
sin(s[, 1] * 2) + cos(s[, 2] * 2) + 0.5 * (s[, 1] * s[, 2])
}
sigma_spatial <- function(s) {
0.15 + 0.40 * sqrt(s[, 1]^2 + s[, 2]^2) / sqrt(8)
}
y_all <- true_surface(s_all) + rnorm(n_train + n_test, mean = 0, sd = sigma_spatial(s_all))
s_train <- s_all[1:n_train, ]
y_train <- y_all[1:n_train]
s_test  <- s_all[(n_train + 1):(n_train + n_test), ]
y_test  <- y_all[(n_train + 1):(n_train + n_test)]
pred_fun <- function(s_train, y_train, s_new) {
fit <- lm(y_train ~ poly(s_train[, 1], 2) + poly(s_train[, 2], 2) + s_train[, 1]:s_train[, 2])
as.numeric(cbind(1, poly(s_new[, 1], 2), poly(s_new[, 2], 2), s_new[, 1] * s_new[, 2]) %*% coef(fit))
}
# 2. الاستدعاء المصحح
out <- scp_geostatistical(
s_train  = s_train,
y_train  = y_train,
s0       = s_test,
pred_fun = pred_fun,
alpha    = 0.10,
seed     = 42
)
# 3. طباعة التقرير
coverage_report(out, y_test)

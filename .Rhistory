# تأكد من تثبيت حزمة القياس إذا لم تكن موجودة
# install.packages("microbenchmark")
library(spconform)
library(sp)
library(microbenchmark)
# 1. تجهيز بيانات Meuse (نفس المستخدمة في ورقتك)
data("meuse", package = "sp")
s <- as.matrix(meuse[, c("x", "y")])
y <- log(meuse$zinc)
# دالة التنبؤ
pred_fun <- function(s_train, y_train, s_new) {
fit <- lm(y_train ~ s_train[, 1] + s_train[, 2] +
I(s_train[, 1]^2) + I(s_train[, 2]^2))
cbind(1, s_new[, 1], s_new[, 2],
s_new[, 1]^2, s_new[, 2]^2) %*% coef(fit)
}
set.seed(1)
idx <- sample(nrow(s), floor(0.7 * nrow(s)))
s_train <- s[idx, ]
y_train <- y[idx]
s_test <- s[-idx, ]
# ==========================================
# الاختبار الأول: على بيانات Meuse (حجم صغير)
# ==========================================
cat("Benchmarking on Meuse dataset (n = 155)...\n")
res_meuse <- microbenchmark(
spconform_run = scp_geostatistical(
s_train = s_train,
y_train = y_train,
s0 = s_test,
pred_fun = pred_fun,
alpha = 0.1
),
times = 20 # تكرار العملية 20 مرة لضمان الدقة
)
print(res_meuse, unit = "ms") # طباعة النتيجة بالميلي ثانية
# ==========================================
# الاختبار الثاني: محاكاة لبيانات كبيرة (1000 نقطة)
# لإبهار المراجعين بسرعتها
# ==========================================
cat("\nBenchmarking on simulated large dataset (n = 1000)...\n")
set.seed(42)
n_large <- 1000
s_large <- cbind(runif(n_large), runif(n_large))
y_large <- rnorm(n_large)
idx_large <- sample(n_large, 700)
res_large <- microbenchmark(
spconform_large = scp_geostatistical(
s_train = s_large[idx_large, ],
y_train = y_large[idx_large],
s0 = s_large[-idx_large, ],
pred_fun = pred_fun,
alpha = 0.1
),
times = 10 # تكرار 10 مرات
)
print(res_large, unit = "s") # طباعة النتيجة بالثواني
